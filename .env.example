# Without this file the app runs in LOCAL MODE: data is saved in this browser only.
#
# For shareable links, copy to .env.local and fill in from the Firebase console:
# Project settings -> General -> Your apps -> Web app -> SDK setup and configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Force local mode even when the values above are set:
# VITE_STORAGE=local
